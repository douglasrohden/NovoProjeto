# =============================================================================
# Document Processing Platform — Next.js Full Stack
# cp .env.example .env
# =============================================================================

# --- Next.js / Docker ---
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# URLs dentro do Docker Compose (já definidas no compose; use localmente ao rodar npm dev)
# DATABASE_URL=postgresql://app_user:change_me_in_production@localhost:5432/documents
# REDIS_URL=redis://localhost:6379

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=documents
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://app_user:change_me_in_production@localhost:5432/documents

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Upload ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25
RETENTION_DAYS=90

# --- Processamento ---
PROCESSING_TIMEOUT_SECONDS=30
WORKER_CONCURRENCY=2
TESSERACT_LANG=por

# --- XML ---
XML_SCHEMA_PATH=./docs/xml-schema.xsd
