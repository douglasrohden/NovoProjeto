# =============================================================================
# Document Processing Platform — Next.js Full Stack
# cp .env.example .env
# =============================================================================

# --- Next.js / Docker ---
APP_IMAGE=document-platform:latest
API_PORT=3000
# Docker Compose força NODE_ENV=production em web/worker; use development só com npm run dev
NODE_ENV=development
LOG_LEVEL=info

# Subir em producao (app + worker + postgres + redis, sem expor DB no host):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#   .\install.ps1 -Production

# Mesma password em POSTGRES_PASSWORD e DATABASE_URL (tem de coincidir com o volume Docker).
# Se mudar a password depois do 1.º `docker compose up`, apague o volume: docker compose down -v

# --- PostgreSQL ---
POSTGRES_HOST=localhost
# Porta 5433 = Postgres do docker-compose (5432 costuma ser PostgreSQL local no Windows)
POSTGRES_PORT=5433
POSTGRES_DB=documents
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://app_user:change_me@localhost:5433/documents

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Upload ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25
RETENTION_DAYS=90

# --- Processamento ---
# true = processa PDF/OCR na mesma app (dev sem worker). false = so fila Redis (producao/Docker).
PROCESS_INLINE=true
PROCESSING_TIMEOUT_SECONDS=30
WORKER_CONCURRENCY=2
TESSERACT_LANG=por

# --- XML ---
XML_SCHEMA_PATH=./docs/xml-schema.xsd
